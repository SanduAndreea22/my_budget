# Copy to .env and fill in real values. .env is gitignored and loaded automatically.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC

# Leave empty to use local SQLite.
DATABASE_URL=

# Resend (welcome/activation email on register, best-effort). Accounts are
# usable immediately either way — a missing/invalid key just logs an error
# to the console instead of blocking registration.
RESEND_API_KEY=
