# Copy to .env and fill in real values. .env is gitignored and loaded automatically.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC

# Leave empty to use local SQLite.
DATABASE_URL=

# Resend (welcome/activation email on register, best-effort). Accounts are
# usable immediately either way — a missing/invalid key just logs an error
# to the console instead of blocking registration.
RESEND_API_KEY=

# Move the Django admin off the guessable "admin/" path in production, e.g.
# ADMIN_URL=admin-a1b2c3/ (keep the trailing slash). Leave empty for "admin/".
ADMIN_URL=

# Optional: move avatar uploads to S3-compatible object storage (AWS S3,
# Cloudflare R2, Backblaze B2, ...) instead of local disk. Needed in
# production on hosts with an ephemeral filesystem (e.g. Render) — without
# it, uploaded avatars are lost on every redeploy/restart. Leave
# AWS_STORAGE_BUCKET_NAME empty to keep using local disk (fine for dev).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
